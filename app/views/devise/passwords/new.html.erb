<div class="min-h-screen flex items-center justify-center bg-[#F5F5F5] px-6 py-12">
  <div class="w-full max-w-sm space-y-8">

    <div class="text-left space-y-3">
      <h2 class="text-4xl font-bold text-gray-900">Esqueceu sua senha?</h2>
      <p class="text-base text-gray-600">
        Informe o e-mail da sua conta. Se ela existir, enviaremos um link para criar uma senha nova.
      </p>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name),
                 data: { turbo: false },
                 html: { method: :post, class: "space-y-5", novalidate: true }) do |f| %>
      <div>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
            <i class="fas fa-envelope text-gray-400"></i>
          </div>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              placeholder: "E-mail",
              "aria-label": "E-mail",
              class: "appearance-none block w-full px-4 py-4 pl-12 border #{field_border(resource, :email)} placeholder-gray-400 text-gray-900 rounded-2xl focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-transparent text-base" %>
        </div>
        <%= field_error(resource, :email) %>
      </div>

      <div class="rounded-2xl bg-white border border-gray-200 p-4 text-sm text-gray-600">
        <i class="fab fa-google text-red-500 mr-1"></i>
        Criou a conta com o Google? Você não precisa de senha: use <strong>Continuar com Google</strong> na tela de login.
      </div>

      <div class="pt-2">
        <%= f.submit "Enviar instruções",
            class: "w-full flex justify-center py-5 px-4 border border-transparent text-base font-semibold rounded-2xl text-white bg-teal-500 hover:bg-teal-600 focus:outline-none transition-all duration-200 shadow-lg cursor-pointer" %>
      </div>
    <% end %>

    <div class="text-center">
      <%= link_to "Voltar para o login", new_session_path(resource_name),
          class: "text-base text-teal-500 hover:text-teal-600 font-medium" %>
    </div>

  </div>
</div>
