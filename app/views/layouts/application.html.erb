<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Runify" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Runify">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <%= javascript_tag nonce: true do %>
      const cookieDarkMode = document.cookie.includes('dark_mode=true');
      const html = document.documentElement;

      if (cookieDarkMode) {
        html.classList.add('dark');
        localStorage.setItem('darkMode', 'true');
      } else {
        html.classList.remove('dark');
        localStorage.setItem('darkMode', 'false');
      }
    <% end %>
  </head>

  <body class="antialiased">
    <div id="toast-container"></div>

    <%= yield %>

    <% toasts = flash_toasts %>
    <% if toasts.any? %>
      <%= javascript_tag nonce: true do %>
        (function() {
          var toasts = <%= raw json_escape(toasts.to_json) %>;
          if (typeof window.showToast === 'function') {
            toasts.forEach(function(toast) { window.showToast(toast.message, toast.type); });
          } else {
            window.pendingToasts = (window.pendingToasts || []).concat(toasts);
          }
        })();
      <% end %>
    <% end %>
  </body>
</html>