<div class="min-h-screen bg-[#0f1117] pb-24">
  
  <%= render 'shared/header' %>

  <main class="px-4 py-6 space-y-6 max-w-2xl mx-auto">
    <section>
      <div class="bg-gradient-to-r from-teal-500 to-teal-600 rounded-2xl p-6 text-white shadow-lg">
        <h2 class="text-2xl font-bold mb-2"><%= @squad.name %></h2>
        <% if @squad.description.present? %>
          <p class="text-sm opacity-90 mb-3"><%= @squad.description %></p>
        <% end %>
        
        <div class="flex items-center gap-4 text-sm">
          <span><i class="fas fa-users mr-1"></i><%= @squad.users.count %> membros</span>
          <% if @squad.challenge_end %>
            <span><i class="fas fa-calendar mr-1"></i>Termina <%= @squad.challenge_end.strftime('%d/%m/%Y') %></span>
          <% else %>
            <span><i class="fas fa-infinity mr-1"></i>Infinito</span>
          <% end %>
        </div>

        <div class="mt-4 pt-4 border-t border-white/20">
          <p class="text-xs opacity-75 mb-2">Código do Pacer</p>
          <div class="flex items-center gap-2">
            <code class="bg-white/20 px-4 py-2 rounded-lg font-mono text-lg font-bold tracking-wider"><%= @squad.squad_code %></code>
            <button id="pacer-copy-code-button" data-code="<%= @squad.squad_code %>" class="bg-white/20 hover:bg-white/30 px-3 py-2 rounded-lg transition-all">
              <i class="fas fa-copy"></i>
            </button>
          </div>
        </div>
      </div>
    </section>
    <section>
      <h3 class="text-xl font-bold text-white mb-4">
        <i class="fas fa-trophy text-orange-400 mr-2"></i>
        Ranking
      </h3>

      <div class="space-y-3">
        <% @leaderboard.each_with_index do |member, index| %>
          <div class="relative card-dark rounded-2xl p-5 shadow-md <%= 'ring-2 ring-teal-500' if member.user == current_user %>">
            <% if index < 3 %>
              <div class="absolute top-3 left-3">
                <div class="w-8 h-8 rounded-full flex items-center justify-center shadow-lg medal-<%= index + 1 %>">
                  <span class="text-white font-bold text-sm"><%= index + 1 %>º</span>
                </div>
              </div>
            <% else %>
              <div class="absolute top-3 left-3">
                <div class="w-8 h-8 rounded-full flex items-center justify-center medal-n">
                  <span class="text-white font-bold text-sm"><%= index + 1 %>º</span>
                </div>
              </div>
            <% end %>

            <div class="flex items-center gap-4 ml-10">

              <%= render "pacers/avatar_frame",
                    member: member,
                    avatar_url: member.user.avatar_url,
                    avatar_alt: member.user.username,
                    filter_id: "glow-#{member.user.id}",
                    size: :md,
                    badge_context: :show %>

              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <h4 class="font-bold text-white truncate">
                    <%= member.user.username %>
                  </h4>
                  <% if member.user == current_user %>
                    <span class="text-xs bg-teal-500/20 text-teal-300 border border-teal-500/30 px-2 py-0.5 rounded-full font-medium flex-shrink-0">Você</span>
                  <% end %>
                </div>
                <p class="text-sm font-semibold <%= member.rank_color_class %>">
                  <i class="fas <%= member.tier_icon %> mr-1"></i><%= member.rank_title %>
                </p>
                
                <div class="mt-2 flex items-center gap-2">
                  <div class="flex-1 xp-bar-track rounded-full h-2 overflow-hidden">
                    <div class="h-2 rounded-full transition-all" style="width: <%= member.xp_progress_percentage %>%; background: <%= member.border_color %>; box-shadow: 0 0 8px <%= member.border_color %>"></div>
                  </div>
                  <span class="text-xs text-gray-400 font-medium flex-shrink-0"><%= member.xp_progress_percentage %>%</span>
                </div>
              </div>

              <div class="text-right flex-shrink-0">
                <p class="text-2xl font-bold text-white"><%= member.experience_points %></p>
                <p class="text-xs text-gray-400">XP</p>
                <% if member.streak > 0 %>
                  <div class="mt-1 inline-flex items-center gap-1 bg-orange-500/20 text-orange-400 border border-orange-500/20 px-2 py-0.5 rounded-full">
                    <i class="fas fa-fire text-xs"></i>
                    <span class="text-xs font-bold"><%= member.streak %></span>
                  </div>
                <% end %>
              </div>

            </div>
          </div>
        <% end %>
      </div>
    </section>

    <!-- Admin / Sair -->
    <% if @squad.owner == current_user %>
      <section>
        <div class="bg-gradient-to-r from-yellow-500 to-amber-500 rounded-2xl p-4 text-white shadow-lg">
          <div class="flex items-center gap-3">
            <i class="fas fa-shield-alt text-2xl"></i>
            <p class="font-semibold">Você é o administrador deste Pacer</p>
          </div>
        </div>
      </section>
    <% else %>
      <%= button_to "Sair do Pacer", leave_pacer_path(@squad), 
          method: :delete,
          data: { confirm: 'Tem certeza que deseja sair deste Pacer?' },
          class: "w-full bg-red-500/80 hover:bg-red-500 text-white font-semibold py-4 px-4 rounded-2xl transition-all shadow-lg border border-red-400/20" %>
    <% end %>

  </main>

  <%= render 'shared/footer' %>

</div>
