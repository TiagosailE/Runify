<%# size: :lg (index) ou :md (show). A moldura ocupa 160% da foto — proporção gravada nos .webp de pacer_frames/. %>
<div class="pacer-avatar pacer-avatar-<%= size %> tier-<%= member.border_tier %>">
  <img src="<%= avatar_url %>" alt="<%= avatar_alt %>" class="pacer-avatar-photo">
  <%= image_tag "pacer_frames/#{member.border_tier}.webp", alt: "", class: "pacer-avatar-frame", decoding: "async" %>
  <div class="level-badge level-badge-on-<%= badge_context %>">
    <%= member.level %>
  </div>
</div>
