<% content_for :title, "Auditoria · Runify Admin" %>

<section>
  <div class="flex items-center justify-between mb-1">
    <h2 class="text-lg font-semibold text-gray-900">
      <i class="fas fa-clock-rotate-left text-teal-500 mr-2"></i>Auditoria
    </h2>
    <span class="text-sm text-gray-500"><%= @audit_logs.size %> ações</span>
  </div>
  <p class="text-xs text-gray-500 mb-4">
    Ações de escrita do painel, da mais recente para a mais antiga (últimas 200).
    Abrir a ficha de alguém não gera registro — o painel não expõe dado pessoal.
  </p>

  <div class="space-y-3">
    <% @audit_logs.each do |log| %>
      <div class="bg-white rounded-2xl p-4 shadow-sm">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="font-bold text-gray-900 text-sm"><%= log.action_label %></p>

            <p class="text-xs text-gray-500 mt-1">
              <i class="fas fa-user text-gray-400 mr-1"></i>
              <%= link_to log.target_user.email, admin_user_path(log.target_user),
                    class: "text-teal-500 hover:text-teal-600 font-medium" %>
            </p>

            <p class="text-xs text-gray-400 mt-0.5">
              por <%= log.admin.email %><%= " · #{log.details}" if log.details.present? %>
            </p>
          </div>

          <span class="text-xs text-gray-400 flex-shrink-0 whitespace-nowrap">
            <%= log.created_at.strftime("%d/%m/%y %H:%M") %>
          </span>
        </div>
      </div>
    <% end %>

    <% if @audit_logs.empty? %>
      <div class="bg-white rounded-2xl p-6 shadow-sm text-center space-y-3">
        <div class="w-16 h-16 bg-teal-500/10 rounded-full flex items-center justify-center mx-auto">
          <i class="fas fa-clock-rotate-left text-2xl text-teal-500"></i>
        </div>
        <h3 class="text-base font-bold text-gray-900">Nenhuma ação registrada ainda</h3>
        <p class="text-sm text-gray-500">
          Quando você usar alguma ação de suporte, ela aparece aqui.
        </p>
      </div>
    <% end %>
  </div>
</section>
