<% content_for :title, "#{@user.email} · Runify Admin" %>

<%= link_to admin_users_path, class: "inline-flex items-center gap-2 text-sm text-gray-500 hover:text-teal-500 font-medium transition-colors" do %>
  <i class="fas fa-chevron-left text-xs"></i>Usuários
<% end %>

<section>
  <div class="bg-white rounded-2xl p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <h2 class="text-lg font-bold text-gray-900 truncate">
            <%= @user.username.presence || "(sem nome)" %>
          </h2>
          <% if @user.admin? %>
            <span class="text-[10px] font-bold uppercase tracking-wide text-teal-600 bg-teal-500/10 rounded-full px-2 py-0.5 flex-shrink-0">admin</span>
          <% end %>
        </div>
        <p class="text-sm text-gray-500 truncate mt-0.5"><%= @user.email %></p>
      </div>
      <div class="w-12 h-12 bg-teal-500/10 rounded-full flex items-center justify-center flex-shrink-0">
        <i class="fas fa-user text-teal-500"></i>
      </div>
    </div>

    <div class="mt-4 pt-4 border-t border-gray-200 space-y-2">
      <div class="flex items-center justify-between text-sm">
        <span class="text-gray-500">ID</span>
        <span class="font-semibold text-gray-900"><%= @user.id %></span>
      </div>
      <div class="flex items-center justify-between text-sm">
        <span class="text-gray-500">Cadastro</span>
        <span class="font-semibold text-gray-900"><%= @user.created_at.strftime("%d/%m/%Y às %H:%M") %></span>
      </div>
      <div class="flex items-center justify-between text-sm">
        <span class="text-gray-500">Aceite dos termos</span>
        <span class="font-semibold text-gray-900"><%= @user.terms_accepted_at&.strftime("%d/%m/%Y") || "—" %></span>
      </div>
    </div>
  </div>
</section>

<section>
  <h2 class="text-lg font-semibold text-gray-900 mb-1">
    <i class="fas fa-clipboard-check text-teal-500 mr-2"></i>Onboarding
  </h2>
  <p class="text-xs text-gray-500 mb-3">Só o preenchimento aparece aqui — nunca o valor do campo.</p>

  <div class="bg-white rounded-2xl p-5 shadow-sm space-y-2.5">
    <% @onboarding.each do |label, filled| %>
      <div class="flex items-center gap-3 text-sm">
        <% if filled %>
          <i class="fas fa-circle-check text-teal-500"></i>
          <span class="text-gray-700"><%= label %></span>
        <% else %>
          <i class="far fa-circle text-orange-400"></i>
          <span class="text-orange-500 font-medium"><%= label %></span>
        <% end %>
      </div>
    <% end %>
  </div>
</section>

<section>
  <h2 class="text-lg font-semibold text-gray-900 mb-4">
    <i class="fas fa-calendar-days text-teal-500 mr-2"></i>Treino
  </h2>

  <div class="bg-white rounded-2xl p-5 shadow-sm">
    <% if @active_plan %>
      <div class="flex items-baseline justify-between mb-3">
        <span class="text-xs font-bold uppercase tracking-wide text-teal-600 bg-teal-500/10 rounded-full px-2 py-1">plano ativo</span>
        <span class="text-xs text-gray-400">#<%= @active_plan.id %></span>
      </div>
      <div class="flex gap-6 mb-4">
        <div>
          <p class="text-2xl font-extrabold text-gray-900 leading-none"><%= @active_plan.current_week %></p>
          <p class="text-gray-400 text-xs mt-1">Semana atual</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-gray-900 leading-none"><%= @active_plan.total_weeks %></p>
          <p class="text-gray-400 text-xs mt-1">Semanas</p>
        </div>
        <div>
          <p class="text-2xl font-extrabold text-gray-900 leading-none"><%= @active_plan.start_date&.strftime("%d/%m") || "—" %></p>
          <p class="text-gray-400 text-xs mt-1">Início</p>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-gray-500 mb-4">
        <i class="fas fa-calendar-xmark text-gray-400 mr-1"></i>Sem plano ativo.
      </p>
    <% end %>

    <div class="pt-4 border-t border-gray-200 space-y-2">
      <div class="flex items-center justify-between text-sm">
        <span class="text-gray-500">Planos no total</span>
        <span class="font-semibold text-gray-900"><%= @plans_count %></span>
      </div>
      <% { "pending" => "Treinos pendentes", "completed" => "Treinos concluídos", "skipped" => "Treinos pulados" }.each do |status, label| %>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500"><%= label %></span>
          <span class="font-semibold text-gray-900"><%= @workout_counts.fetch(status, 0) %></span>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section>
  <h2 class="text-lg font-semibold text-gray-900 mb-4">
    <i class="fas fa-person-running text-teal-500 mr-2"></i>Atividades
  </h2>

  <div class="bg-white rounded-2xl p-5 shadow-sm space-y-2">
    <div class="flex items-center justify-between text-sm">
      <span class="text-gray-500">Total registrado</span>
      <span class="font-semibold text-gray-900"><%= @activities_count %></span>
    </div>
    <% @activity_sources.each do |source, count| %>
      <div class="flex items-center justify-between text-sm">
        <span class="text-gray-500">Origem <%= source %></span>
        <span class="font-semibold text-gray-900"><%= count %></span>
      </div>
    <% end %>
    <div class="flex items-center justify-between text-sm">
      <span class="text-gray-500">Última atividade</span>
      <span class="font-semibold text-gray-900"><%= @last_activity&.start_date&.strftime("%d/%m/%Y") || "—" %></span>
    </div>
    <div class="flex items-center justify-between text-sm">
      <span class="text-gray-500">Notificações não lidas</span>
      <span class="font-semibold text-gray-900"><%= @unread_notifications %></span>
    </div>
  </div>
</section>

<section>
  <h2 class="text-lg font-semibold text-gray-900 mb-4">
    <i class="fab fa-strava text-orange-500 mr-2"></i>Strava e Pacers
  </h2>

  <div class="bg-white rounded-2xl p-5 shadow-sm">
    <% if @strava %>
      <div class="space-y-2">
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500">Athlete</span>
          <span class="font-semibold text-gray-900"><%= @strava.strava_athlete_id %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500">Integração ativa</span>
          <span class="font-semibold text-gray-900"><%= @strava.active? ? "sim" : "não" %></span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500">Token</span>
          <span class="font-semibold <%= @strava.token_expired? ? "text-orange-500" : "text-gray-900" %>">
            <%= @strava.token_expired? ? "expirado" : "válido" %>
          </span>
        </div>
        <div class="flex items-center justify-between text-sm">
          <span class="text-gray-500">Última sincronização</span>
          <span class="font-semibold text-gray-900"><%= @strava.last_sync_at&.strftime("%d/%m/%Y %H:%M") || "—" %></span>
        </div>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Strava não conectado.</p>
    <% end %>

    <div class="mt-4 pt-4 border-t border-gray-200">
      <% if @squad_members.any? %>
        <div class="space-y-2.5">
          <% @squad_members.each do |member| %>
            <div class="flex items-center justify-between gap-3 text-sm">
              <span class="text-gray-700 truncate">
                <i class="fas fa-users text-teal-500 mr-1.5"></i><%= member.squad.name %>
                <% if member.squad.owner_id == @user.id %>
                  <span class="text-[10px] font-bold uppercase tracking-wide text-gray-500 bg-gray-100 rounded-full px-2 py-0.5 ml-1">dono</span>
                <% end %>
              </span>
              <span class="text-xs text-gray-400 flex-shrink-0 whitespace-nowrap">
                Lv <%= member.level %> · <%= member.experience_points %> XP
              </span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">Não participa de nenhum Pacer.</p>
      <% end %>
    </div>
  </div>
</section>

<section>
  <h2 class="text-lg font-semibold text-gray-900 mb-1">
    <i class="fas fa-screwdriver-wrench text-teal-500 mr-2"></i>Ações de suporte
  </h2>
  <p class="text-xs text-gray-500 mb-3">
    Todas reversíveis e registradas em Auditoria. Editar dados e excluir conta não estão aqui de propósito.
  </p>

  <div class="bg-white rounded-2xl p-5 shadow-sm space-y-3">
    <%= button_to send_password_reset_admin_user_path(@user),
          method: :post,
          form: { data: { turbo_confirm: "Enviar e-mail de redefinição de senha para #{@user.email}?" } },
          class: "w-full bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold py-3 px-4 rounded-xl transition-all text-sm cursor-pointer" do %>
      <i class="fas fa-key mr-2 text-gray-400"></i>Enviar redefinição de senha
    <% end %>

    <%= button_to cancel_training_plan_admin_user_path(@user),
          method: :post,
          disabled: @active_plan.nil?,
          form: { data: { turbo_confirm: "Cancelar o plano ativo? O usuário poderá gerar um novo." } },
          class: "w-full bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 font-semibold py-3 px-4 rounded-xl transition-all text-sm cursor-pointer disabled:cursor-not-allowed disabled:opacity-40" do %>
      <i class="fas fa-calendar-xmark mr-2 text-gray-400"></i>Cancelar plano ativo
    <% end %>

    <%= button_to disconnect_strava_admin_user_path(@user),
          method: :delete,
          disabled: @strava.nil?,
          form: { data: { turbo_confirm: "Desconectar o Strava deste usuário? Ele poderá reconectar sozinho." } },
          class: "w-full bg-white border border-red-200 hover:bg-red-50 text-red-600 font-semibold py-3 px-4 rounded-xl transition-all text-sm cursor-pointer disabled:cursor-not-allowed disabled:opacity-40" do %>
      <i class="fab fa-strava mr-2"></i>Desconectar Strava
    <% end %>
  </div>
</section>

<section>
  <h2 class="text-lg font-semibold text-gray-900 mb-4">
    <i class="fas fa-clock-rotate-left text-teal-500 mr-2"></i>Auditoria deste usuário
  </h2>

  <div class="bg-white rounded-2xl p-5 shadow-sm">
    <% if @audit_logs.any? %>
      <div class="space-y-3">
        <% @audit_logs.each do |log| %>
          <div class="flex items-start justify-between gap-3 text-sm">
            <div class="min-w-0">
              <p class="text-gray-900 font-medium"><%= log.action_label %></p>
              <p class="text-xs text-gray-400 truncate">
                <%= log.admin.email %><%= " · #{log.details}" if log.details.present? %>
              </p>
            </div>
            <span class="text-xs text-gray-400 flex-shrink-0 whitespace-nowrap">
              <%= log.created_at.strftime("%d/%m %H:%M") %>
            </span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">Nenhuma ação administrativa registrada.</p>
    <% end %>
  </div>
</section>
