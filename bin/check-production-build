#!/usr/bin/env bash
# Repete o passo de build do Dockerfile: assets:precompile em producao, sem
# master key. Roda numa copia dos arquivos versionados (config/master.key fica
# no .gitignore e portanto nao vai junto), entao nao depende do que ha no
# diretorio de trabalho.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

cd "$root"
# A copia usa as mesmas gems ja instaladas (no Actions ficam em vendor/bundle).
gems="$(bundle exec ruby -e 'path = Bundler.settings[:path]; print File.expand_path(path) if path')"
git ls-files -z | tar --null --ignore-failed-read -T - -cf - | tar -x -C "$tmp"
cd "$tmp"
env ${gems:+BUNDLE_PATH="$gems"} BUNDLE_GEMFILE="$tmp/Gemfile" BUNDLE_WITHOUT=development RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 \
  bin/rails assets:precompile
